{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Enumu",
  "version": "0.1.0",
  "identifier": "com.somniel.enumu",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Enumu",
        "width": 1040,
        "height": 760,
        "minWidth": 520,
        "minHeight": 440
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}